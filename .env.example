# Copy to .env and fill in real values. Never commit .env.

# --- Environment ---
NODE_ENV=development
APP_ENV=development           # development | staging | production
APP_ORIGIN=http://localhost:3000   # used for CSRF Origin checks

# --- Database ---
# Requires PostgreSQL 15+. PostGIS extension needed starting Phase 2.
#
# If using Supabase: Project Settings -> Database -> Connection string.
# DATABASE_URL = the "Transaction" pooler string (port 6543) with ?pgbouncer=true appended.
#                 Used by the running app.
# DIRECT_URL   = the "Session"/direct connection string (port 5432), no pgbouncer param.
#                 Used only by `prisma migrate` (PgBouncer can't run migrations).
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres"

# --- Auth ---
BCRYPT_COST=12
SESSION_TTL_HOURS=720          # 30 days
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# --- Feature flags (defaults; can be overridden in DB via SystemSetting/FeatureFlag) ---
ENABLE_AI=false
ENABLE_VPN=false
ENABLE_REWARDS=false
ENABLE_B2B_API=false
ENABLE_ASK_LOCAL=false
ENABLE_OFFLINE_MODE=false
ENABLE_BUSINESS_CLAIMS=false

# --- Tourist search (Phase 6) ---
# Only "UTC" is currently supported for "open now" filtering — see
# DECISIONS.md D26. Ghana is UTC+0, so this matches the launch market.
DEFAULT_TIMEZONE=UTC

# --- Not yet wired (Phase 3+/9+), placeholders documenting future config ---
# SMS_PROVIDER_API_KEY=
# EMAIL_PROVIDER_API_KEY=
# PAYMENT_PROVIDER_API_KEY=
# THREAT_INTEL_PROVIDER_API_KEY=
# AI_PROVIDER_API_KEY=
# MAPS_PROVIDER_API_KEY=
